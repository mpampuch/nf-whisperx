manifest {
    name            = 'nf-whisperx'
    author          = 'mpampuch'
    homePage        = 'https://github.com/mpampuch/nf-whisperx'
    description     = 'Convert video files to MP3 and transcribe using WhisperX'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
    doi             = ''
}